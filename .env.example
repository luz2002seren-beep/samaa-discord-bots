# Configure up to three independent Discord bots.
BOT_1_TOKEN=your_first_bot_token
BOT_2_TOKEN=your_second_bot_token
BOT_3_TOKEN=your_third_bot_token
DISCORD_TOKEN=your_bot_token
NODELINK_HOST=127.0.0.1
NODELINK_PORT=2333
NODELINK_PASSWORD=change_this_to_a_long_random_password
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: comma-separated Discord user IDs permitted to configure the bot globally
BOT_OWNERS=
